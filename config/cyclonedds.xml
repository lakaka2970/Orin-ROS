<?xml version="1.0" encoding="UTF-8"?>
<!--
  FT Radar Framework — CycloneDDS 配置 (兼容 ROS2 Foxy / CycloneDDS 0.7.x)
  ============================================================================
  Foxy 自带的 CycloneDDS 0.7.x 不支持 <SharedMemory> 和带单位的 WhcHigh,
  因此使用精简配置: 仅限定本地回环 + 关闭多播, 其余使用 CycloneDDS 默认值.

  本地 SHM 传输由 CycloneDDS 根据 lo 接口自动启用, 无需显式配置.

  用法:
    export CYCLONEDDS_URI="file://<path>/config/cyclonedds.xml"
  ============================================================================
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <NetworkInterfaceAddress>lo</NetworkInterfaceAddress>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Tracing>
      <Verbosity>warning</Verbosity>
    </Tracing>
  </Domain>
</CycloneDDS>
