<?xml version="1.0"?>
<!--
================================================================================
CycloneDDS 共享内存 (SHM) 传输配置文件
================================================================================
⚠️  此配置仅适用于 Jetson AGX Orin 裸机 Linux 部署！
    WSL 环境中 /dev/shm 和 SHM 传输不可靠，此配置无效。
    WSL 开发时请使用默认的 Fast-RTPS UDP 传输。

用途: 在同机 (localhost) 节点间启用 SHM 传输，消除 socket send/receive 路径上的
      32 MiB/帧 memcpy 开销（16T16R ctrx0+ctrx1 合并），大幅降低 ADC 数据发布时延与 CPU 占用。

启用方式 (Jetson 裸机):
  export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
  export CYCLONEDDS_URI=file:`realpath $PWD/config/cyclonedds_shm.xml`

前置条件:
  - CycloneDDS 0.10.0 以上版本（自带 SHM 支持）
  - 所有同机节点使用同一 URI 启动
  - /dev/shm 挂载且大小充足 (Jetson 默认 ~3.5 GB)

作者: zhengyuan.liu
日期: 2026.6.17
================================================================================
-->
<CycloneDDS>
    <Domain>
        <!-- ──── SHM 传输配置 ──── -->
        <Shm>
            <!-- 启用 SHM 域 (共享内存传输) -->
            <Enable>true</Enable>

            <!-- SHM 默认传输策略:
                 - "default": 所有发现的对端都尝试使用 SHM
                 - "explicit": 仅当 QoS 显式请求 SHM 时才使用
                 - "only": 仅使用 SHM，不回退到 UDP (仅开发调试)
            -->
            <Policy>default</Policy>

            <!-- 最大 SHM 区域大小 (单条消息上限)。
                 32 MiB ADC 帧 + 安全余量 → 64 MiB。
                 /dev/shm 总大小: Jetson AGX Orin 默认 3.5 GB (/dev/shm 为 tmpfs)。
                 10 个节点 × 64 MiB × 2 (pub/sub) ≈ 1.28 GB，足够容纳。
            -->
            <DefaultAllocationSize>67108864</DefaultAllocationSize>
        </Shm>

        <!-- ──── 网络传输配置 (SHM 回退路径) ──── -->
        <General>
            <!-- 最大消息大小: 适配 32 MiB ADC 帧 (16T16R ctrx0+ctrx1) -->
            <MaxMessageSize>33554432</MaxMessageSize>

            <!-- 允许绑定到多播接口 (DDS 发现必需) -->
            <AllowMulticast>default</AllowMulticast>

            <!-- 网络接口: 仅 localhost (SHM 模式下不需要以太网) -->
            <Interfaces>
                <NetworkInterface name="lo" />
            </Interfaces>
        </General>

        <!-- ──── 发布/订阅 QoS 覆写 ──── -->
        <Publication>
            <!-- ADC 数据: 最佳努力，不阻塞等待确认 -->
            <Whitelist>
                <TopicPrefix>adc</TopicPrefix>
            </Whitelist>
        </Publication>
        <Subscription>
            <Whitelist>
                <TopicPrefix>adc</TopicPrefix>
            </Whitelist>
        </Subscription>

        <!-- ──── 编解码器: 仅启用 CDDR (本地传输不需要 XTypes) ──── -->
        <DataReader>
            <Whitelist>
                <TopicPrefix>*</TopicPrefix>
            </Whitelist>
        </DataWriter>
    </Domain>
</CycloneDDS>
