<?xml version="1.0" encoding="UTF-8"?>
<!--
  FT Radar Framework — FastDDS SHM 共享内存传输配置 (强制 SHM only)
  ============================================================================
  FastDDS (rmw_fastrtps_cpp) 内置 SHM 传输, 同机节点间所有消息走共享内存,
  32MB ADC 帧不经网络栈, 零 UDP 分片.

  传输策略:
    - 所有节点 → SHM (共享内存, 512MB 段, 容纳 16 帧)
    - 无 UDP 回退: SHM 满时阻塞等待 (避免静默性能降级)

  用法:
    export FASTRTPS_DEFAULT_PROFILES_FILE="/path/to/config/fastdds.xml"
    (由 scripts/env.sh 自动加载)

  版本要求:
    - eProsima FastDDS 2.1+ (ROS2 Foxy 自带 2.1.4)
    - /dev/shm 挂载且可用 (Jetson 默认 tmpfs, ~3.5GB)

  变更历史:
    2026-07-02: segment_size 128→512MB, useBuiltinTransports true→false
               (perf 分析: 128MB 仅容 4 帧, SHM 满→UDP 回退→0.8Hz 帧率塌陷)
  ============================================================================
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <!-- ── SHM 传输描述符 ── -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>ft_shm_transport</transport_id>
      <type>SHM</type>
      <!-- 512MB 段: 容纳 16 帧 × 32MB + 余量, 避免段满回退 UDP -->
      <segment_size>536870912</segment_size>
    </transport_descriptor>
  </transport_descriptors>

  <!-- ── 默认 Participant 配置 (纯 SHM, 无 UDP 回退) ── -->
  <!--
    策略: 仅使用 SHM 共享内存传输.
    - SHM 段 512MB, 容纳 16 帧 × 32MB
    - scripts/env.sh 每次 source 时自动清理僵尸段, SHM 不会用完
    - 如 SHM 初始化失败, 节点将报错退出 (不会静默回退到慢速 UDP)
  -->
  <participant profile_name="ft_default_participant" is_default_profile="true">
    <rtps>
      <!-- 仅使用自定义 SHM 传输 -->
      <userTransports>
        <transport_id>ft_shm_transport</transport_id>
      </userTransports>
      <!-- 关闭内置 UDP 传输: 32MB 帧走 UDP 会被切分为 512 分片, 每帧耗时 ~1s -->
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>

</profiles>
