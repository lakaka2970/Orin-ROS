# ============================================================================
# 雷达检测目标点消息
# ============================================================================
# 与 FT_radar_dataset_requirement.md 第 5/6 节雷达点云字段完全对齐，共 14 个字段。
#
# 坐标系定义:
#   车辆系: X=前方, Y=左侧, Z=上方, 原点=后轴中心接地点
#   雷达系: azimuth/elevation/range/raw_doppler 在雷达传感器坐标系下
#
# 过滤规则（默认阈值）:
#   ROI:      x∈[-80,200], y∈[-40,40], z∈[-15,15] m
#   高度:     |z| >= |x| × 0.1 + 2
#   RCS:      ≤10m: RCS<=-40; >10m: RCS<=-20 (dBsm)
#   存在概率: exist_prob < 30 → 剔除
#   idx:      idx == 255 (SNA) → 剔除
#   模糊概率: ambgt_prob < 40 → 剔除
# ============================================================================

# ---- 空间位置（车辆坐标系） ----
float32 x                     # 车辆系纵向坐标 (m), 前方为正, [-80, 200]
float32 y                     # 车辆系横向坐标 (m), 左侧为正, [-40, 40]
float32 z                     # 车辆系垂直坐标 (m), 上方为正, [-15, 15]

# ---- 雷达原视测量（雷达传感器坐标系） ----
float32 range                 # 径向距离 (m), 雷达传感器系
float32 azimuth               # 方位角 (rad), 雷达传感器系
float32 elevation             # 俯仰角 (rad), 雷达传感器系

# ---- 信号特征 ----
float32 rcs                   # 雷达散射截面积 (dBsm), 物理值域 [-100, 129.37]
float32 snr                   # 信噪比 (dB), [0, 63.75], 可选字段（缺失填 0）

# ---- 多普勒信息（速度解模糊） ----
float32 ambgt                 # 速度模糊窗宽 (m/s), 典型值 3-15,
                              # 即 FFT 多普勒最大不模糊度范围（上限减下限）
uint8   exist_prob            # 存在概率 [0,255], 阈值: ≥30 保留, 255=无效
uint8   multi_tgt_prob        # 多目标概率 [0,255], 255=无效, 可选字段
uint8   ambgt_prob            # 模糊概率 [0,255], 阈值: ≥40 保留, 255=无效
float32 raw_doppler           # 原始多普勒径向速度 (m/s), 雷达传感器系,
                              # 经硬件一次解模糊后的速度
uint8   idx                   # 多普勒解模糊索引,
                              # idx >= 0: idx = 倍数 + 128
                              # idx 负值: idx = 192 - 倍数
                              # idx = 255: SNA(杂波/无效点) → 过滤
                              # idx = 0: 多普勒解模糊失败
